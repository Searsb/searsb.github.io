---
interface Props {
  title?: string;
}

const { title = "Bryan Sears" } = Astro.props;
---

<header class="header">
  <nav class="nav-container">
    <div class="logo">
      <a href="/" class="logo-text">{title}</a>
    </div>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/about">About</a></li>
    </ul>
  </nav>
</header>

<style>
  .header {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    border-bottom: 2px solid #d4af37;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 4px 12px rgba(212, 175, 55, 0.1);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    flex: 1;
  }

  .logo-text {
    font-size: 1.8rem;
    font-weight: bold;
    background: linear-gradient(135deg, #9d4edd 0%, #d4af37 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .logo-text:hover {
    opacity: 0.8;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: #e0e0e0;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
    padding-bottom: 0.25rem;
  }

  .nav-links a:hover {
    color: #d4af37;
  }

  .nav-links a:before {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #9d4edd, #d4af37);
    transition: width 0.3s ease;
  }

  .nav-links a:hover:before {
    width: 100%;
  }

  @media (max-width: 768px) {
    .nav-container {
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
    }

    .nav-links {
      gap: 1rem;
      flex-direction: column;
      align-items: center;
    }

    .logo-text {
      font-size: 1.5rem;
    }
  }
</style>
